# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Secret used to sign session JWTs (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# --- ONDC seller app (optional; see README "ONDC integration") ---
ONDC_ENABLED=false
ONDC_SUBSCRIBER_ID=stora.example.com
# Public URL ONDC calls us on (registered as subscriber_url); actions live under /api/ondc
ONDC_SUBSCRIBER_URL=https://stora.example.com/api/ondc
ONDC_UNIQUE_KEY_ID=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_SIGNING_PUBLIC_KEY=
ONDC_ENCRYPTION_PRIVATE_KEY=
ONDC_ENCRYPTION_PUBLIC_KEY=
# preprod: https://preprod.registry.ondc.org   prod: https://prod.registry.ondc.org
ONDC_REGISTRY_URL=https://preprod.registry.ondc.org
# ONDC's own X25519 public key for that environment (from the ONDC onboarding docs)
ONDC_REGISTRY_ENC_PUBLIC_KEY=
# request_id sent in /subscribe; its signature is served at /ondc-site-verification.html
ONDC_REQUEST_ID=
# Origin used to turn relative image URLs (/api/files/...) into absolute ones
ONDC_PUBLIC_BASE_URL=https://stora.example.com
# "lat,lng" for stores that have no coordinates saved
ONDC_DEFAULT_GPS=
ONDC_CITY_CODE=*
ONDC_SELLER_APP_NAME=Stora
ONDC_SUPPORT_PHONE=
ONDC_SUPPORT_EMAIL=
ONDC_SUPPORT_URI=
# Local testing only (ignored when NODE_ENV=production)
ONDC_SKIP_SIGNATURE_VERIFY=false
